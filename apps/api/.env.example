# The API's environment, parsed at boot by src/config/env.ts — a missing or
# malformed variable stops the start with its name. `pnpm bootstrap` copies this
# file to .env, fills in the Supabase block from the local stack, and keeps
# whatever you have already set. An empty value means unset.

# ── Server ────────────────────────────────────────────────────────────────────

# Port the API listens on; the web app's NEXT_PUBLIC_API_URL points here.
PORT=4000
# The web app's origin — the one origin the API accepts cross-origin calls from.
WEB_ORIGIN=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Written by `pnpm bootstrap` from `supabase status`. Only the publishable key:
# the API reaches Postgres as the signed-in user, so row-level security is what
# scopes every query, and no service-role key is ever configured.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── Chat model ────────────────────────────────────────────────────────────────
# Any server speaking the OpenAI API. The provider is a preset — openai, groq,
# together, openrouter, ollama, custom — naming the default base URL and what
# the server supports; `custom` has no default, so it needs CHAT_BASE_URL.
# CHAT_BASE_URL overrides any preset's URL (a proxy, a self-hosted gateway).

CHAT_PROVIDER=openai
CHAT_MODEL=gpt-5-mini
# Required by every preset but ollama and custom.
CHAT_API_KEY=
CHAT_BASE_URL=

# ── Embedding model ───────────────────────────────────────────────────────────
# Configured apart from chat, because not every provider serves both — groq and
# openrouter serve no embeddings. The same presets otherwise.

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Must equal the dimension of document_chunks.embedding, vector(1536); the API
# refuses to start on a mismatch. A model with another size (nomic-embed-text
# on ollama is 768) needs a migration changing the column, then a re-embed.
EMBEDDING_DIMENSIONS=1536
# Texts sent per embeddings request.
EMBEDDING_BATCH_SIZE=64
