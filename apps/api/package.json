{
  "name": "@kb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import ./register.js src/main.ts",
    "build": "swc src -d dist --strip-leading-paths --ignore \"**/*.test.ts\"",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./register.js --test \"src/**/*.test.ts\"",
    "test:e2e": "node --import ./register.js --test --test-concurrency=1 \"test/**/*.e2e.test.ts\"",
    "db:types": "supabase gen types typescript --local > src/database/database.types.ts && prettier --write src/database/database.types.ts"
  },
  "dependencies": {
    "@kb/contracts": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@supabase/supabase-js": "^2.117.1",
    "jose": "^6.2.12",
    "openai": "^7.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6"
  }
}
