# Next.js inlines NEXT_PUBLIC_* variables into the client bundle at build time —
# the static export has no server to read them at runtime — so a change here
# needs a rebuild, and nothing secret belongs here. `pnpm bootstrap` copies this
# file to .env and fills it in from the local stack.

# From `supabase status`: sign-in goes straight from the browser to Supabase
# Auth, with the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the API listens — its PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000
