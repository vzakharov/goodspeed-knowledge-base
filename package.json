{
  "name": "knowledge-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "node --import tsx --test \"scripts/**/*.test.ts\" && turbo run test",
    "type-overlap": "tsx scripts/type-overlap-check.ts",
    "lint": "eslint . --fix",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:fsd": "steiger apps/web/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "styles:codegen": "node scripts/generate-styles.ts",
    "costs": "node scripts/costs-report.ts",
    "test:e2e": "turbo run test:e2e",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "turbo run db:types"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@steiger/toolkit": "0.2.3",
    "@types/estree": "^1.0.9",
    "@types/estree-jsx": "^1.0.5",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "steiger": "^0.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "supabase": "^2.117.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "zod": "^4.5.4"
  }
}
